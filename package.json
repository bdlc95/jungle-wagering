{
  "name": "jungle-wagering",
  "version": "0.0.1",
  "description": "Distributed wagering processor — Jungle Gaming technical challenge",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "bunx --bun tsc --noEmit",
    "test": "bun test src/domain/domain.spec.ts",
    "test:integration": "bun test/run-integration.ts",
    "test:watch": "bun test src/domain/domain.spec.ts --watch",
    "test:cov": "bun test src/domain/domain.spec.ts --coverage",
    "test:e2e": "bun test ./test/app.e2e-spec.ts",
    "smoke": "bun test/smoke.ts",
    "db:migrate": "bun src/persistence/migrate.ts",
    "db:rollback": "bun src/persistence/migrate.ts down",
    "infra:setup": "bun src/messaging/setup-queues.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1154.0",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/nestjs": "^6",
    "@mikro-orm/postgresql": "^6",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "ajv": "^8",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
